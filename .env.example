# RSS Feed Reader - 環境変数設定ファイル
# このファイルを .env にコピーして使用してください

# レシピAPI設定
# ================================================

# TheMealDB API (デフォルトで有効、APIキー不要)
# https://www.themealdb.com/api.php

# 楽天レシピAPI
# https://webservice.rakuten.co.jp/
# 無料プランあり - 月間10,000リクエスト
# VITE_RAKUTEN_APP_ID=your_rakuten_app_id_here

# 乗換検索API設定
# ================================================

# Google Maps Directions API
# https://console.cloud.google.com/
# 無料枠: 月間$200相当（約40,000リクエスト）
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# サービス選択
# ================================================

# レシピサービス: 'mealdb' | 'rakuten' | 'both'
VITE_RECIPE_SERVICE=mealdb

# 乗換検索サービス: 'google' | 'mock'
VITE_TRANSIT_SERVICE=mock

# デバッグモード
# ================================================
VITE_DEBUG_MODE=false
