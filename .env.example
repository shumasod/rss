# RSS Feed Reader - 環境変数設定ファイル
# このファイルを .env にコピーして使用してください:
#   cp .env.example .env

# ============================================================
# レシピ検索サービスの選択
# ============================================================
# 選択肢: mealdb | rakuten | spoonacular | edamam
# デフォルト: mealdb（APIキー不要）
VITE_RECIPE_SERVICE=mealdb

# --- TheMealDB（デフォルト）---
# APIキー不要・完全無料
# 英語の国際レシピデータベース
# https://www.themealdb.com/api.php

# --- 楽天レシピ ---
# 日本語レシピ、無料枠: 月10,000リクエスト
# 登録: https://webservice.rakuten.co.jp/
# VITE_RAKUTEN_APP_ID=your_rakuten_app_id_here

# --- Spoonacular ---
# 多機能レシピAPI、無料枠: 150リクエスト/日（クレカ不要）
# 登録: https://spoonacular.com/food-api/console#Dashboard
# VITE_SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# --- Edamam ---
# 栄養情報付きレシピ、無料枠: 10リクエスト/分
# 登録: https://developer.edamam.com/
# VITE_EDAMAM_APP_ID=your_edamam_app_id_here
# VITE_EDAMAM_APP_KEY=your_edamam_app_key_here

# ============================================================
# 乗換検索サービスの選択
# ============================================================
# 選択肢: mock | osrm | navitia | google
# デフォルト: osrm（APIキー不要・完全無料）
VITE_TRANSIT_SERVICE=osrm

# --- モックデータ ---
# APIキー不要、デモ用固定データ

# --- OSRM（推奨・完全無料）---
# APIキー不要、徒歩/自転車/車の経路
# 住所検索: OpenStreetMap Nominatim使用
# https://project-osrm.org/

# --- Navitia（公共交通機関対応）---
# 月90,000リクエスト無料（メール登録のみ）
# 電車・バス・地下鉄などに対応
# 登録: https://navitia.io/register/
# サンドボックストークン（テスト用・パリのモックデータ）:
# VITE_NAVITIA_TOKEN=3b036afe-0110-4202-b9ed-99718476c2e0
# 本番用（メール登録後に受け取ったトークン）:
# VITE_NAVITIA_TOKEN=your_navitia_token_here

# --- Google Maps ---
# 月$200無料枠（要クレジットカード登録）
# https://console.cloud.google.com/
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================
# デバッグ設定
# ============================================================
VITE_DEBUG_MODE=false
